                        <button onclick="openServiceModal('Cloud Infrastructure & DevOps', 'Build robust, scalable cloud foundations using AWS, GCP, or Azure. We specialize in Kubernetes orchestration, Terraform Infrastructure as Code (IaC), zero-downtime deployments, and automated monitoring systems designed for mission-critical operations.')" class="inline-flex items-center space-x-1 text-sm font-medium text-white hover:text-blue-400 transition-colors">
                            <span>Learn more</span>
                            <i data-lucide="chevron-right" class="w-4 h-4"></i>
                        </button>
                    </div>
                </div>

                <!-- Service 2 -->
                <div class="group p-8 rounded-2xl bg-slate-900/60 border border-slate-800 hover:border-blue-500/50 transition-all duration-300 flex flex-col justify-between">
                    <div>
                        <div class="w-12 h-12 rounded-xl bg-indigo-500/10 border border-indigo-500/20 flex items-center justify-center text-indigo-400 mb-6 group-hover:scale-110 transition-transform">
                            <i data-lucide="brain" class="w-6 h-6"></i>
                        </div>
                        <h3 class="text-xl font-semibold text-white">AI & Machine Learning Solutions</h3>
                        <p class="mt-3 text-slate-400 text-sm leading-relaxed">Custom LLM integration, predictive analytics, NLP pipelines, and automated intelligence workflows tailored for your data.</p>
                    </div>
                    <div class="mt-8 pt-6 border-t border-slate-800/80 flex items-center justify-between">
                        <span class="text-xs font-semibold text-indigo-400 uppercase tracking-wider">Advanced Tech</span>
                        <button onclick="openServiceModal('AI & Machine Learning Solutions', 'Unlock the power of your data with state-of-the-art machine learning models. We build custom RAG pipelines, fine-tune open-source LLMs, embed automated forecasting engines, and seamlessly integrate artificial intelligence into existing enterprise stacks.')" class="inline-flex items-center space-x-1 text-sm font-medium text-white hover:text-blue-400 transition-colors">
                            <span>Learn more</span>
                            <i data-lucide="chevron-right" class="w-4 h-4"></i>
                        </button>
                    </div>
                </div>

                <!-- Service 3 -->
                <div class="group p-8 rounded-2xl bg-slate-900/60 border border-slate-800 hover:border-blue-500/50 transition-all duration-300 flex flex-col justify-between">
                    <div>
                        <div class="w-12 h-12 rounded-xl bg-emerald-500/10 border border-emerald-500/20 flex items-center justify-center text-emerald-400 mb-6 group-hover:scale-110 transition-transform">
                            <i data-lucide="shield-check" class="w-6 h-6"></i>
                        </div>
                        <h3 class="text-xl font-semibold text-white">Cybersecurity & Auditing</h3>
                        <p class="mt-3 text-slate-400 text-sm leading-relaxed">Comprehensive penetration testing, vulnerability assessments, compliance management (SOC2, GDPR), and zero-trust security setups.</p>
                    </div>
                    <div class="mt-8 pt-6 border-t border-slate-800/80 flex items-center justify-between">
                        <span class="text-xs font-semibold text-emerald-400 uppercase tracking-wider">Bulletproof Security</span>
                        <button onclick="openServiceModal('Cybersecurity & Auditing', 'Protect your digital assets from sophisticated cyber threats. Our ethical hacking team performs exhaustive penetration testing, code reviews, IAM hardening, and regulatory compliance audits to ensure impenetrable system resilience.')" class="inline-flex items-center space-x-1 text-sm font-medium text-white hover:text-blue-400 transition-colors">
