        // Site configuration
        // -----------------------------------------
        const CONTACT_EMAIL = 'smartinvestsi254@gmail.com';

        // -----------------------------------------
        // Initialize Lucide icons safely
        // -----------------------------------------
        try {
            if (window.lucide) {
                lucide.createIcons();
            }
        } catch (err) {
            console.error("Lucide init error:", err);
        }

        // -----------------------------------------
        // PayPal Donate SDK
        // -----------------------------------------
        <script
            src="https://www.paypalobjects.com/donate/sdk/donate-sdk.js"
            charset="UTF-8">
        </script>

        <!-- PayPal donation button -->
        <div
            id="paypal-donate-button-container"
            class="min-h-[52px] flex items-center justify-center">
        </div>
        
        <script>
        document.addEventListener("DOMContentLoaded", function () {
            const paypalContainer =
                document.getElementById("paypal-donate-button-container");
        
            try {
                if (
                    paypalContainer &&
                    window.PayPal &&
                    PayPal.Donation &&
                    PayPal.Donation.Button
                ) {
                    PayPal.Donation.Button({
                        env: "production",
                        hosted_button_id: "26SLEPXAKRGSE",
        
                        image: {
                            src: "https://www.paypalobjects.com/en_US/i/btn/btn_donateCC_LG.gif",
                            title: "PayPal - The safer, easier way to pay online!",
                            alt: "Donate with PayPal"
                        },
        
                        onComplete: function (params) {
                            const thankyouEl =
                                document.getElementById("paypal-thankyou");
        
                            if (thankyouEl) {
                                thankyouEl.classList.remove("hidden");
                            }
        
                            console.info(
                                "PayPal donation completed:",
                                params
                            );
                        }
                    }).render("#paypal-donate-button-container");
        
                } else {
                    showPayPalFallback();
                }
        
            } catch (err) {
                console.error("PayPal Donate SDK error:", err);
                showPayPalFallback();
            }
        });
        
        function showPayPalFallback() {
            const container =
                document.getElementById("paypal-donate-button-container");
        
            if (!container) return;
        
            container.innerHTML = `
                <a
                    href="https://www.paypal.com/donate/?hosted_button_id=26SLEPXAKRGSE"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="px-6 py-3 rounded-xl bg-blue-600 hover:bg-blue-500 text-white text-sm font-semibold inline-flex items-center justify-center space-x-2 transition-colors"
                    aria-label="Donate securely through PayPal"
                >
                    <span>Donate via PayPal</span>
                    <i
                        data-lucide="external-link"
                        class="w-4 h-4"
                        aria-hidden="true">
                    </i>
                </a>
        
                <p class="mt-3 text-xs text-slate-500">
                    PayPal's secure donation page
                </p>
            `;
        
            if (window.lucide) {
                lucide.createIcons();
            }
        }
        </script>
    
        // -----------------------------------------
        // Email / Gmail compose
        // -----------------------------------------
        function openEmailCompose(type = "general") {
            if (!CONTACT_EMAIL || CONTACT_EMAIL === "smartinvestsi254@gmail.com") {
                alert("Please set CONTACT_EMAIL in index.html first. Replace YOUR_EMAIL@example.com with the address that should receive website requests.");
                return;
            }

            const subjects = {
                general: "Website Request / General Inquiry",
                quote: "Project Quote Request",
                support: "Technical Support Request",
                service: "Service Inquiry",
                partnership: "Partnership / Business Inquiry"
            };

            const bodies = {
                general:
                    "Hello NexisTech,%0D%0A%0D%0AI would like to make an inquiry about your services.%0D%0A%0D%0ARequest details:%0D%0A%0D%0AThank you.",
                quote:
                    "Hello NexisTech,%0D%0A%0D%0AI would like to request a project quote.%0D%0A%0D%0AProject/service:%0D%0ABudget (optional):%0D%0ATimeline (optional):%0D%0ARequirements:%0D%0A%0D%0AThank you.",
                support:
                    "Hello NexisTech,%0D%0A%0D%0AI need technical support.%0D%0A%0D%0AIssue:%0D%0ASite/project:%0D%0ADetails:%0D%0A%0D%0AThank you.",
                service:
                    "Hello NexisTech,%0D%0A%0D%0AI am interested in one of your professional services.%0D%0A%0D%0AService:%0D%0ARequirements:%0D%0A%0D%0AThank you.",
                partnership:
                    "Hello NexisTech,%0D%0A%0D%0AI would like to discuss a partnership/business opportunity.%0D%0A%0D%0ADetails:%0D%0A%0D%0AThank you."
            };

            const subject = encodeURIComponent(subjects[type] || subjects.general);
            const body = bodies[type] || bodies.general;
            const mailtoUrl = `mailto:${CONTACT_EMAIL}?subject=${subject}&body=${body}`;

            // mailto is the most reliable way to hand the message to
            // the user's installed email client, including Gmail on Android.
            window.location.href = mailtoUrl;
        }

        // Gmail web compose fallback for users who prefer browser Gmail.
        function openGmailCompose(type = "general") {
            if (!CONTACT_EMAIL || CONTACT_EMAIL === "YOUR_EMAIL@example.com") {
                alert("Please set CONTACT_EMAIL in index.html first.");
                return;
            }

            const subjectMap = {
                general: "Website Request / General Inquiry",
                quote: "Project Quote Request",
                support: "Technical Support Request",
                service: "Service Inquiry",
                partnership: "Partnership / Business Inquiry"
            };

            const subject = encodeURIComponent(subjectMap[type] || subjectMap.general);
            const gmailUrl = `https://mail.google.com/mail/?view=cm&fs=1&to=${encodeURIComponent(CONTACT_EMAIL)}&su=${subject}`;
            window.open(gmailUrl, "_blank", "noopener,noreferrer");
        }

        // Interactive Cost Estimator Logic

        function calculateEstimate() {
            try {
                const serviceBase = parseInt(document.getElementById('calc-service').value) || 2500;
                const scale = parseInt(document.getElementById('calc-scale').value) || 2;
                
                const scaleLabels = { 1: "Startup / MVP (1x)", 2: "Growing Enterprise (1.8x)", 3: "Global Scale (2.8x)" };
                const scaleMultipliers = { 1: 1.0, 2: 1.8, 3: 2.8 };
                const timelineMap = { 1: "1 - 2 Weeks", 2: "3 - 4 Weeks", 3: "6 - 8 Weeks" };

                document.getElementById('scale-label').innerText = scaleLabels[scale] || scaleLabels[2];

                let total = serviceBase * (scaleMultipliers[scale] || 1.8);

                if (document.getElementById('addon-support') && document.getElementById('addon-support').checked) total += 1200;
                if (document.getElementById('addon-audit') && document.getElementById('addon-audit').checked) total += 800;

                document.getElementById('est-price').innerText = '$' + Math.round(total).toLocaleString();
                document.getElementById('est-time').innerText = timelineMap[scale] || "3 - 4 Weeks";
            } catch (err) {
                console.error("Calculator error:", err);
            }
        }

        // Service Modal Handlers
        function openServiceModal(title, desc) {
            document.getElementById('modal-title').innerText = title;
            document.getElementById('modal-desc').innerText = desc;
            document.getElementById('service-modal').classList.remove('hidden');
        }

        function closeServiceModal() {
            document.getElementById('service-modal').classList.add('hidden');
        }

        function showEstimateModal() {
            document.getElementById('proposal-modal').classList.remove('hidden');
        }

        function closeEstimateModal() {
            document.getElementById('proposal-modal').classList.add('hidden');
        }
    </script>
</body>
</html>
