<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="NexisTech professional digital engineering and consulting services. View our 8ft round hanging ceiling banner design.">
    <meta name="theme-color" content="#020617">
    <title>NexisTech Professional Services | 8ft × 2ft Hanging Banner</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Configure Tailwind for dark mode support -->
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        brand: {
                            50: '#eff6ff',
                            100: '#dbeafe',
                            500: '#3b82f6',
                            600: '#2563eb',
                            700: '#1d4ed8',
                            900: '#1e3a8a',
                        }
                    }
                }
            }
        }
    </script>
    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>
    <!-- Google Fonts: Inter -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Inter', sans-serif;
        }
        /* Custom scrollbar for smooth modern UX */
        ::-webkit-scrollbar {
            width: 8px;
        }
        ::-webkit-scrollbar-track {
            background: #0f172a;
        }
        ::-webkit-scrollbar-thumb {
            background: #334155;
            border-radius: 4px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #475569;
        }

        /* 8ft round x 2ft hanging banner display */
        .banner-display {
            position: relative;
            overflow: hidden;
            border-radius: 1.5rem;
            border: 1px solid rgba(59, 130, 246, 0.25);
            background: #ffffff;
            box-shadow: 0 25px 70px rgba(0, 0, 0, 0.35);
        }

        .banner-artwork {
            position: relative;
            aspect-ratio: 12.5625 / 1; /* 301.5in x 24in including 0.125in bleed */
            min-height: 92px;
            overflow: hidden;
            background:
                radial-gradient(circle at 72% 50%, rgba(59,130,246,.22), transparent 13%),
                linear-gradient(90deg, #082d66 0%, #0b3b82 24%, #ffffff 37%, #ffffff 67%, #0b3b82 79%, #082d66 100%);
        }

        .banner-artwork::before,
        .banner-artwork::after {
            content: "";
            position: absolute;
            top: -30%;
            width: 18%;
            height: 160%;
            transform: skewX(-25deg);
            pointer-events: none;
        }

        .banner-artwork::before {
            left: 18%;
            background: linear-gradient(90deg, #ff9900 0 28%, #1e63f0 29% 58%, transparent 59%);
            opacity: .95;
        }

        .banner-artwork::after {
            right: 18%;
            background: linear-gradient(90deg, transparent 0 40%, #1e63f0 41% 68%, #ff9900 69%);
            opacity: .95;
        }

        .banner-content {
            position: absolute;
            inset: 0;
            z-index: 2;
            display: grid;
            grid-template-columns: 25% 50% 25%;
            align-items: center;
            gap: 1rem;
            padding: 0 2.5%;
            color: #082d66;
        }

        .banner-brand {
            color: #ffffff;
            font-size: clamp(.8rem, 2.2vw, 2rem);
            font-weight: 800;
            letter-spacing: -.04em;
            white-space: nowrap;
        }

        .banner-brand .accent { color: #ff9900; }

        .banner-tagline {
            margin-top: .15rem;
            color: #ffffff;
            font-size: clamp(.35rem, .9vw, .8rem);
            letter-spacing: .08em;
            text-transform: uppercase;
        }

        .banner-center {
            text-align: center;
        }

        .banner-center h3 {
            margin: 0;
            color: #082d66;
            font-size: clamp(.7rem, 2.3vw, 2.15rem);
            line-height: 1.05;
            font-weight: 800;
        }

        .banner-center h3 span { color: #ff9900; }

        .banner-center p {
            margin: .25rem 0 0;
            color: #102f63;
            font-size: clamp(.35rem, .9vw, .85rem);
            font-weight: 600;
            letter-spacing: .08em;
        }

        .banner-features {
            justify-self: end;
            color: #ffffff;
            font-size: clamp(.32rem, .8vw, .75rem);
            line-height: 1.55;
            font-weight: 700;
            white-space: nowrap;
        }

        .banner-features div::before {
            content: "✓";
            color: #ffcc33;
            margin-right: .35rem;
        }

        .banner-spec {
            margin-top: .75rem;
            text-align: center;
            color: #94a3b8;
            font-size: .72rem;
        }

        .banner-note {
            margin-top: 1rem;
            padding: .75rem 1rem;
            border-radius: .75rem;
            border: 1px solid rgba(59,130,246,.2);
            background: rgba(15,23,42,.65);
            color: #94a3b8;
            font-size: .78rem;
            text-align: center;
        }

        @media (max-width: 640px) {
            .banner-display { border-radius: 1rem; }
            .banner-artwork { min-height: 70px; }
            .banner-content { padding: 0 2%; gap: .25rem; }
            .banner-features { display: none; }
            .banner-content { grid-template-columns: 30% 70%; }
            .banner-center { text-align: right; }
            .banner-center h3 { font-size: clamp(.62rem, 4vw, 1.05rem); }
            .banner-brand { font-size: clamp(.62rem, 3.8vw, 1rem); }
            .banner-tagline { font-size: .28rem; }
        }

    </style>
</head>
<body class="bg-slate-950 text-slate-100 antialiased selection:bg-brand-500 selection:text-white">

    <header class="fixed top-0 left-0 right-0 z-50 bg-slate-950/80 backdrop-blur-md border-b border-slate-800/80 transition-all duration-300">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
            <div class="flex items-center space-x-3">
                <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-blue-600 to-indigo-500 flex items-center justify-center shadow-lg shadow-blue-500/30">
                    <i data-lucide="cpu" class="w-6 h-6 text-white"></i>
                </div>
                <span class="text-xl font-bold tracking-tight bg-gradient-to-r from-white via-slate-200 to-slate-400 bg-clip-text text-transparent">
                    NexisTech
                </span>
            </div>
            
            <nav class="hidden md:flex items-center space-x-8 text-sm font-medium text-slate-300">
                <a href="#services" class="hover:text-blue-400 transition-colors">Services</a>
                <a href="#calculator" class="hover:text-blue-400 transition-colors">Estimator</a>
                <a href="#about" class="hover:text-blue-400 transition-colors">About</a>
                <a href="#testimonials" class="hover:text-blue-400 transition-colors">Testimonials</a>
                <a href="#faq" class="hover:text-blue-400 transition-colors">FAQ</a>
                <a href="#banner" class="hover:text-blue-400 transition-colors">Banner</a>
                <button type="button" onclick="openEmailCompose('general')" class="hidden lg:inline-flex items-center space-x-2 text-slate-300 hover:text-blue-400 transition-colors" aria-label="Email NexisTech">
                    <i data-lucide="mail" class="w-4 h-4" aria-hidden="true"></i>
                    <span>Email Us</span>
                </button>
                                <a href="#support" class="hover:text-blue-400 transition-colors">Support Us</a>
            </nav>

            <div class="flex items-center space-x-4">
                <a href="https://discord.gg/vXpA3cS95" target="_blank" rel="noopener noreferrer" class="hidden sm:inline-flex items-center space-x-2 px-4 py-2 rounded-lg bg-indigo-600 hover:bg-indigo-500 text-white text-sm font-semibold transition-all shadow-lg shadow-indigo-600/20">
                    <i data-lucide="message-square" class="w-4 h-4"></i>
                    <span>Discord</span>
                </a>
                <a href="#support" class="inline-flex items-center space-x-2 px-4 py-2 rounded-lg bg-gradient-to-r from-blue-600 to-indigo-600 hover:from-blue-500 hover:to-indigo-500 text-white text-sm font-semibold transition-all shadow-lg shadow-blue-600/30">
                    <i data-lucide="heart" class="w-4 h-4 text-pink-300 fill-pink-300" aria-hidden="true"></i>
                    <span>Donate</span>
                </a>
            </div>
        </div>
    </header>


    <!-- 8ft Round x 2ft Hanging Ceiling Banner -->
    <section id="banner" class="py-16 bg-slate-950 border-b border-slate-900">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="text-center max-w-3xl mx-auto mb-8">
                <div class="inline-flex items-center space-x-2 px-3 py-1 rounded-full bg-orange-500/10 border border-orange-500/20 text-orange-400 text-xs font-medium mb-4">
                    <i data-lucide="layout-template" class="w-3.5 h-3.5"></i>
                    <span>8ft Round × 2ft High Hanging Banner</span>
                </div>
                <h2 class="text-3xl sm:text-4xl font-bold tracking-tight text-white">NexisTech Display Banner</h2>
                <p class="mt-3 text-slate-400">
                    Responsive website preview of the print artwork. The physical banner is 8 ft in diameter × 2 ft high;
                    the flat artwork follows the circular circumference.
                </p>
            </div>

            <div class="banner-display">
                <div class="banner-artwork" role="img" aria-label="NexisTech 8-foot round hanging ceiling banner artwork preview">
                    <div class="banner-content">
                        <div>
                            <div class="banner-brand">Nex<span class="accent">Exchange</span></div>
                            <div class="banner-tagline">Trade • Swap • Grow</div>
                        </div>

                        <div class="banner-center">
                            <h3>Your Global <span>Crypto</span> Exchange</h3>
                            <p>Secure &nbsp;|&nbsp; Fast &nbsp;|&nbsp; Reliable</p>
                        </div>

                        <div class="banner-features">
                            <div>Buy &amp; Sell Crypto</div>
                            <div>Top-Level Security</div>
                            <div>Low Fees</div>
                            <div>Global Access</div>
                        </div>
                    </div>
                </div>
            </div>

            <p class="banner-spec">
                Print reference: 25.13 ft × 2 ft artwork area (301.5 in × 24 in), based on an 8 ft diameter circular banner.
            </p>

            <div class="banner-note">
                <strong class="text-slate-200">Production note:</strong>
                This is a responsive website preview, not the final print file. For manufacturing, use the printer's exact template,
                bleed, color profile, and safe-area requirements.
            </div>
        </div>
    </section>

    <section class="relative pt-32 pb-20 md:pt-44 md:pb-32 overflow-hidden">
        <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-blue-900/20 via-slate-950/0 to-slate-950/0 pointer-events-none"></div>
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 text-center">
            <div class="inline-flex items-center space-x-2 px-3 py-1 rounded-full bg-blue-500/10 border border-blue-500/20 text-blue-400 text-xs font-medium mb-6">
                <i data-lucide="sparkles" class="w-3.5 h-3.5"></i>
                <span>Professional Digital Engineering & Consulting</span>
            </div>
            <h1 class="text-4xl sm:text-6xl lg:text-7xl font-extrabold tracking-tight text-white max-w-4xl mx-auto leading-tight">
                Architecting the Future of <span class="bg-gradient-to-r from-blue-400 via-indigo-300 to-indigo-500 bg-clip-text text-transparent">Digital Solutions</span>
            </h1>
            <p class="mt-6 text-lg sm:text-xl text-slate-400 max-w-2xl mx-auto leading-relaxed">
                NexisTech provides elite-tier engineering, cloud infrastructure, AI integration, and cybersecurity services designed to scale your business effortlessly. No signups required to explore or consult.
            </p>
            <div class="mt-10 flex flex-col sm:flex-row items-center justify-center gap-4">
                <a href="#services" class="w-full sm:w-auto px-8 py-4 rounded-xl bg-blue-600 hover:bg-blue-500 text-white font-semibold transition-all shadow-xl shadow-blue-600/30 flex items-center justify-center space-x-2">
                    <span>Explore Services</span>
                    <i data-lucide="arrow-right" class="w-4 h-4"></i>
                </a>
                <a href="#calculator" class="w-full sm:w-auto px-8 py-4 rounded-xl bg-slate-900 hover:bg-slate-800 text-slate-200 border border-slate-800 font-semibold transition-all flex items-center justify-center space-x-2">
                    <i data-lucide="calculator" class="w-4 h-4 text-blue-400"></i>
                    <span>Project Cost Estimator</span>
                </a>
                <button type="button" onclick="openEmailCompose('quote')" class="w-full sm:w-auto px-8 py-4 rounded-xl bg-white hover:bg-slate-100 text-slate-950 font-semibold transition-all flex items-center justify-center space-x-2">
                    <i data-lucide="mail" class="w-4 h-4" aria-hidden="true"></i>
                    <span>Email Us</span>
                </button>
            </div>

            <!-- Stats Bar -->
            <div class="mt-20 grid grid-cols-2 md:grid-cols-4 gap-6 max-w-5xl mx-auto pt-10 border-t border-slate-900">
                <div class="p-4 rounded-2xl bg-slate-900/40 border border-slate-900">
                    <div class="text-3xl font-bold text-white">99.9%</div>
                    <div class="text-sm text-slate-400 mt-1">Uptime SLA Architecture</div>
                </div>
                <div class="p-4 rounded-2xl bg-slate-900/40 border border-slate-900">
                    <div class="text-3xl font-bold text-white">250+</div>
                    <div class="text-sm text-slate-400 mt-1">Enterprise Projects Delivered</div>
                </div>
                <div class="p-4 rounded-2xl bg-slate-900/40 border border-slate-900">
                    <div class="text-3xl font-bold text-white">24/7</div>
                    <div class="text-sm text-slate-400 mt-1">Global Expert Support</div>
                </div>
                <div class="p-4 rounded-2xl bg-slate-900/40 border border-slate-900">
                    <div class="text-3xl font-bold text-white">100%</div>
                    <div class="text-sm text-slate-400 mt-1">Client Satisfaction Rate</div>
                </div>
            </div>
        </div>
    </section>

    <section id="services" class="py-24 bg-slate-900/30 border-y border-slate-900">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="text-center max-w-3xl mx-auto mb-16">
                <h2 class="text-3xl sm:text-4xl font-bold tracking-tight text-white">Our Core Services</h2>
                <p class="mt-4 text-slate-400">Comprehensive technology solutions engineered to drive efficiency, security, and exponential growth.</p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
                <!-- Service 1 -->
                <div class="group p-8 rounded-2xl bg-slate-900/60 border border-slate-800 hover:border-blue-500/50 transition-all duration-300 flex flex-col justify-between">
                    <div>
                        <div class="w-12 h-12 rounded-xl bg-blue-500/10 border border-blue-500/20 flex items-center justify-center text-blue-400 mb-6 group-hover:scale-110 transition-transform">
                            <i data-lucide="cloud" class="w-6 h-6"></i>
                        </div>
                        <h3 class="text-xl font-semibold text-white">Cloud Infrastructure & DevOps</h3>
