                </div>

                <!-- Service 6 -->
                <div class="group p-8 rounded-2xl bg-slate-900/60 border border-slate-800 hover:border-blue-500/50 transition-all duration-300 flex flex-col justify-between">
                    <div>
                        <div class="w-12 h-12 rounded-xl bg-rose-500/10 border border-rose-500/20 flex items-center justify-center text-rose-400 mb-6 group-hover:scale-110 transition-transform">
                            <i data-lucide="compass" class="w-6 h-6"></i>
                        </div>
                        <h3 class="text-xl font-semibold text-white">Technical Advisory & CTO Consulting</h3>
                        <p class="mt-3 text-slate-400 text-sm leading-relaxed">Strategic technology roadmapping, technical due diligence for investors, team upskilling, and architectural reviews.</p>
                    </div>
                    <div class="mt-8 pt-6 border-t border-slate-800/80 flex items-center justify-between">
                        <span class="text-xs font-semibold text-rose-400 uppercase tracking-wider">Executive Strategy</span>
                        <button onclick="openServiceModal('Technical Advisory & CTO Consulting', 'Scale your engineering organization with seasoned fractional CTO leadership. We guide technology roadmaps, mentor engineering teams, conduct rigorous M&A technical due diligence, and help align tech stacks with long-term business goals.')" class="inline-flex items-center space-x-1 text-sm font-medium text-white hover:text-blue-400 transition-colors">
                            <span>Learn more</span>
                            <i data-lucide="chevron-right" class="w-4 h-4"></i>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section id="calculator" class="py-24 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="bg-gradient-to-b from-slate-900 to-slate-900/60 border border-slate-800 rounded-3xl p-8 sm:p-12 lg:p-16 shadow-2xl">
            <div class="max-w-3xl mx-auto text-center mb-12">
                <div class="inline-flex items-center space-x-2 px-3 py-1 rounded-full bg-blue-500/10 border border-blue-500/20 text-blue-400 text-xs font-medium mb-4">
                    <i data-lucide="sliders" class="w-3.5 h-3.5"></i>
                    <span>Instant Project Estimator</span>
                </div>
                <h2 class="text-3xl sm:text-4xl font-bold tracking-tight text-white">Calculate Your Project Investment</h2>
                <p class="mt-3 text-slate-400">Configure your requirements below to instantly generate a transparent cost and timeline estimate.</p>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-3 gap-12 items-start">
                <div class="lg:col-span-2 space-y-8">
                    <!-- Service Type Selector -->
                    <div>
                        <label class="block text-sm font-semibold text-slate-300 mb-3">1. Select Primary Service Focus</label>
                        <select id="calc-service" onchange="calculateEstimate()" class="w-full bg-slate-950 border border-slate-800 rounded-xl px-4 py-3 text-slate-200 focus:outline-none focus:border-blue-500 transition-colors">
                            <option value="2500">Cloud Infrastructure & DevOps ($2,500 base)</option>
                            <option value="3500">AI & Machine Learning Solutions ($3,500 base)</option>
                            <option value="3000">Cybersecurity & Auditing ($3,000 base)</option>
                            <option value="2000">Full-Stack Web & App Engineering ($2,000 base)</option>
                            <option value="1800">Database Optimization & Architecture ($1,800 base)</option>
                            <option value="4000">Technical Advisory & CTO Consulting ($4,000 base)</option>
                        </select>
                    </div>

                    <!-- Project Scale Slider -->
                    <div>
                        <div class="flex justify-between items-center mb-3">
                            <label class="text-sm font-semibold text-slate-300">2. Project Complexity & Scope</label>
                            <span id="scale-label" class="text-sm font-bold text-blue-400">Medium Enterprise</span>
                        </div>
                        <input type="range" id="calc-scale" min="1" max="3" value="2" step="1" oninput="calculateEstimate()" class="w-full accent-blue-500 cursor-pointer">
                        <div class="flex justify-between text-xs text-slate-500 mt-2">
                            <span>Startup / MVP</span>
                            <span>Growing Enterprise</span>
                            <span>Global Scale</span>
                        </div>
                    </div>

                    <!-- Add-on Toggles -->
                    <div>
                        <label class="block text-sm font-semibold text-slate-300 mb-3">3. Additional Requirements</label>
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                            <label class="flex items-center space-x-3 p-4 rounded-xl bg-slate-950 border border-slate-800 cursor-pointer hover:border-slate-700 transition-colors">
                                <input type="checkbox" id="addon-support" value="1200" onchange="calculateEstimate()" class="w-4 h-4 accent-blue-500 rounded">
                                <span class="text-sm text-slate-300">24/7 Priority SLA Support (+$1,200)</span>
                            </label>
                            <label class="flex items-center space-x-3 p-4 rounded-xl bg-slate-950 border border-slate-800 cursor-pointer hover:border-slate-700 transition-colors">
                                <input type="checkbox" id="addon-audit" value="800" onchange="calculateEstimate()" class="w-4 h-4 accent-blue-500 rounded">
                                <span class="text-sm text-slate-300">Express Delivery Rush (+$800)</span>
                            </label>
                        </div>
                    </div>
                </div>

